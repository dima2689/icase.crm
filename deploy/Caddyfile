# iCase · обратный прокси и раздача CRM. Сертификаты Let's Encrypt выпускаются автоматически.
#   {$CRM_DOMAIN} — приложение CRM (статичные файлы из /srv/icase/crm)
#   {$API_DOMAIN} — база (Supabase API: auth, rest, realtime, storage, functions)
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

(common) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), payment=(), usb=()"
	}
	log {
		output file /data/logs/{args[0]}.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
}

{$CRM_DOMAIN} {
	import common crm
	root * /srv/icase/crm
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://{$API_DOMAIN}; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN} https://fonts.googleapis.com https://fonts.gstatic.com; media-src 'self' blob:; worker-src 'self'; frame-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}
	# service worker и config.js всегда свежие; остальные файлы — короткий кэш (у SW своя версия)
	@nocache path /sw.js /js/config.js /index.html / /*.webmanifest
	header @nocache Cache-Control "no-cache"
	@static path /js/* /icons/* /styles.css
	header @static Cache-Control "public, max-age=3600"
	@hidden path /.git* /deploy/* /db/* /supabase/* /docs/* /integrations/* /tests/* /*.md
	respond @hidden 404
	try_files {path} /index.html
	file_server
}

{$API_DOMAIN} {
	import common api
	# Studio и служебные пути наружу не открываем: Studio доступна только через SSH-туннель (127.0.0.1:3000)
	@api path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /functions/v1/* /graphql/v1
	handle @api {
		reverse_proxy api-gw:8000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		respond "iCase API" 404
	}
}
