# /etc/icase/icase.env — настройки сервера iCase (права 600, владелец root). В git не кладётся.
# ── домены (A-записи обоих должны указывать на IP сервера) ──
CRM_DOMAIN=crm.example.ru          # приложение CRM
API_DOMAIN=api.example.ru          # база (Supabase API)
ACME_EMAIL=admin@example.ru        # почта для Let's Encrypt (уведомления о сертификатах)

# ── адрес, куда CRM возвращает после писем (вход, сброс пароля) ──
# по умолчанию https://$CRM_DOMAIN
#SITE_URL=

# ── почта для писем входа/сброса пароля (SMTP вашего почтового сервиса: Яндекс 360, Mail.ru, Unisender Go …) ──
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=crm@example.ru
SMTP_PASS=
SMTP_ADMIN_EMAIL=crm@example.ru
SMTP_SENDER_NAME="iCase CRM"

# ── бэкапы в S3-совместимое хранилище (Selectel / Timeweb Cloud / Yandex Object Storage) ──
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=icase-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
BACKUP_KEEP_DAYS=14                # ежедневные копии
BACKUP_KEEP_WEEKS=8                # воскресные копии
# пароль шифрования бэкапов (храните копию отдельно от сервера — без него бэкап не открыть)
BACKUP_PASSPHRASE=

# ── уведомления о сбоях (необязательно): бот Telegram ──
#ALERT_TG_TOKEN=
#ALERT_TG_CHAT=
